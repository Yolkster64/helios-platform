<UserControl x:Class="HELIOS.WPF.Components.Cards.ServiceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="300"
             Height="200">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Theme/Colors.xaml"/>
        <ResourceDictionary Source="../../Theme/Brushes.xaml"/>
        <ResourceDictionary Source="../../Theme/Styles.xaml"/>
        <ResourceDictionary Source="../../Theme/Animations.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Border Background="{StaticResource BackgroundSecondaryBrush}"
            BorderBrush="{StaticResource MonadoCyanBrush}"
            BorderThickness="2"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect 
                Color="#00D4FF" 
                BlurRadius="20" 
                ShadowDepth="0" 
                Opacity="0.4"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Service Header -->
            <Grid Grid.Row="0" Margin="16,12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="SERVICE_NAME"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"/>

                <!-- Status Indicator -->
                <Ellipse Grid.Column="1" 
                        Width="12" 
                        Height="12" 
                        Fill="{StaticResource StatusSuccessBrush}"
                        VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect 
                            Color="#00FF00" 
                            BlurRadius="10" 
                            ShadowDepth="0" 
                            Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- Service Details -->
            <StackPanel Grid.Row="1" Margin="16,0,16,12" Orientation="Vertical" VerticalAlignment="Top">
                <TextBlock Text="Status: RUNNING" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="13"
                          Margin="0,4"/>
                <TextBlock Text="CPU: 12.5%" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="13"
                          Margin="0,4"/>
                <TextBlock Text="Memory: 256 MB" 
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="13"
                          Margin="0,4"/>
            </StackPanel>

            <!-- Footer Action -->
            <Button Grid.Row="2"
                   Content="MANAGE"
                   Background="{StaticResource ElectricBlueBrush}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="16,0,16,12"
                   Padding="12,6"
                   Cursor="Hand"
                   FontWeight="SemiBold"/>
        </Grid>
    </Border>
</UserControl>
