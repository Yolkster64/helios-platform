<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Import Themes -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Brushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Font Sizes -->
    <system:Double x:Key="FontSizeXXSmall">10</system:Double>
    <system:Double x:Key="FontSizeXSmall">12</system:Double>
    <system:Double x:Key="FontSizeSmall">14</system:Double>
    <system:Double x:Key="FontSizeNormal">16</system:Double>
    <system:Double x:Key="FontSizeMedium">18</system:Double>
    <system:Double x:Key="FontSizeLarge">24</system:Double>
    <system:Double x:Key="FontSizeXLarge">32</system:Double>
    <system:Double x:Key="FontSizeXXLarge">48</system:Double>

    <!-- Font Families -->
    <FontFamily x:Key="FontFamilySegoe">Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Consolas, monospace</FontFamily>
    <FontFamily x:Key="FontFamilyLight">Segoe UI Light, sans-serif</FontFamily>

    <!-- Button Styles -->
    <Style x:Key="GlowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ElectricBlueBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySegoe}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <Border x:Name="GlowBorder" 
                            Background="{StaticResource ElectricBlueBrush}"
                            BorderThickness="2"
                            BorderBrush="{StaticResource ElectricBlueBrush}"
                            CornerRadius="4"
                            Opacity="0.3"/>
                    <Border x:Name="MainBorder" 
                            Background="{StaticResource ElectricBlueBrush}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GlowBorder" 
                                                   Storyboard.TargetProperty="Opacity"
                                                   From="0.3" To="0.8" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetName="MainBorder" 
                                                   Storyboard.TargetProperty="Opacity"
                                                   From="1" To="0.85" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GlowBorder" 
                                                   Storyboard.TargetProperty="Opacity"
                                                   From="0.8" To="0.3" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetName="MainBorder" 
                                                   Storyboard.TargetProperty="Opacity"
                                                   From="0.85" To="1" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource CyanToBlueGradient}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Text Block Styles -->
    <Style x:Key="TextBlockTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySegoe}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TextBlockHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySegoe}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TextBlockBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySegoe}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Panel Styles -->
    <Style x:Key="DarkPanelStyle" TargetType="Panel">
        <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
    </Style>

    <!-- Border Styles -->
    <Style x:Key="GlowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource MonadoCyanBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
    </Style>

    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MonadoCyanBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

</ResourceDictionary>
