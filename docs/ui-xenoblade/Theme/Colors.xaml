<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Colors -->
    <Color x:Key="MonadoCyan">#00D4FF</Color>
    <Color x:Key="ElectricBlue">#0080FF</Color>
    <Color x:Key="GoldAccent">#FFD700</Color>
    <Color x:Key="DeepBlue">#001F4D</Color>
    <Color x:Key="DarkSlate">#0A0E27</Color>
    <Color x:Key="BrightWhite">#F5F5F5</Color>

    <!-- Secondary Colors -->
    <Color x:Key="CyanLight">#00E5FF</Color>
    <Color x:Key="CyanDark">#00A8CC</Color>
    <Color x:Key="BlueLight">#5BA3FF</Color>
    <Color x:Key="BlueDark">#003C99</Color>
    <Color x:Key="GoldLight">#FFED4E</Color>
    <Color x:Key="GoldDark">#CCB000</Color>

    <!-- Neutral Colors -->
    <Color x:Key="BackgroundPrimary">#0A0E27</Color>
    <Color x:Key="BackgroundSecondary">#151A35</Color>
    <Color x:Key="BackgroundTertiary">#202A4A</Color>
    <Color x:Key="TextPrimary">#F5F5F5</Color>
    <Color x:Key="TextSecondary">#B0B8D0</Color>
    <Color x:Key="TextTertiary">#7A8299</Color>
    <Color x:Key="Divider">#1E2847</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusSuccess">#00FF00</Color>
    <Color x:Key="StatusWarning">#FFB300</Color>
    <Color x:Key="StatusError">#FF3D3D</Color>
    <Color x:Key="StatusInfo">#00D4FF</Color>
    <Color x:Key="StatusPending">#8B7FBF</Color>

    <!-- Glow & Effect Colors -->
    <Color x:Key="GlowCyan">#00D4FF</Color>
    <Color x:Key="GlowCyanBright">#66ECFF</Color>
    <Color x:Key="GlowBlue">#0080FF</Color>
    <Color x:Key="GlowGold">#FFD700</Color>
    <Color x:Key="ScanLineColor">#00D4FF</Color>

    <!-- Opacity Variants -->
    <Color x:Key="CyanTransparent">#4D00D4FF</Color>
    <Color x:Key="BlueTransparent">#4D0080FF</Color>
    <Color x:Key="GoldTransparent">#4DFFB300</Color>
    <Color x:Key="WhiteTransparent">#80F5F5F5</Color>
    <Color x:Key="DarkTransparent">#CC0A0E27</Color>

</ResourceDictionary>
