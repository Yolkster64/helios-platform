<!--
    NON-CANONICAL PALETTE - reference only (do not consume from app XAML, and do not
    "fix" colors here). The single color authority for all HELIOS UI is
    src/gui/HELIOS.Shell/Themes/Tokens.xaml and its sibling theme packs
    (decision record: docs/architecture/GUI_UPGRADE_PLAN.md section 2). Mine this file
    for ramps and treatments; route any token change through Tokens.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Import Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="MonadoCyanBrush" Color="{StaticResource MonadoCyan}"/>
    <SolidColorBrush x:Key="ElectricBlueBrush" Color="{StaticResource ElectricBlue}"/>
    <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldAccent}"/>
    <SolidColorBrush x:Key="DeepBlueBrush" Color="{StaticResource DeepBlue}"/>
    <SolidColorBrush x:Key="DarkSlateBrush" Color="{StaticResource DarkSlate}"/>
    <SolidColorBrush x:Key="BrightWhiteBrush" Color="{StaticResource BrightWhite}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiary}"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccess}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}"/>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfo}"/>

    <!-- Radial Glow Gradients (Monado Glow) -->
    <RadialGradientBrush x:Key="MonadoGlowGradient" RadiusX="1" RadiusY="1">
        <GradientStop Color="#6600D4FF" Offset="0"/>
        <GradientStop Color="#3300D4FF" Offset="0.6"/>
        <GradientStop Color="#0000D4FF" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="ElectricBlueGlowGradient" RadiusX="1" RadiusY="1">
        <GradientStop Color="#660080FF" Offset="0"/>
        <GradientStop Color="#330080FF" Offset="0.6"/>
        <GradientStop Color="#000080FF" Offset="1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="GoldGlowGradient" RadiusX="1" RadiusY="1">
        <GradientStop Color="#66FFD700" Offset="0"/>
        <GradientStop Color="#33FFD700" Offset="0.6"/>
        <GradientStop Color="#00FFD700" Offset="1"/>
    </RadialGradientBrush>

    <!-- Linear Gradients -->
    <LinearGradientBrush x:Key="CyanToBlueGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00D4FF" Offset="0"/>
        <GradientStop Color="#0080FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueToDeepBlueGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0080FF" Offset="0"/>
        <GradientStop Color="#001F4D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkSlateBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0E27" Offset="0"/>
        <GradientStop Color="#151A35" Offset="1"/>
    </LinearGradientBrush>

    <!-- Holographic Overlay Brushes -->
    <LinearGradientBrush x:Key="HolographicScanLinesBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.1">
        <GradientStop Color="#00D4FF" Offset="0"/>
        <GradientStop Color="#00D4FF" Offset="0.5"/>
        <GradientStop Color="#FFFFFF" Offset="0.5"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Border Brushes with Glow -->
    <SolidColorBrush x:Key="GlowBorderCyan" Color="#00D4FF" Opacity="0.8"/>
    <SolidColorBrush x:Key="GlowBorderBlue" Color="#0080FF" Opacity="0.8"/>
    <SolidColorBrush x:Key="GlowBorderGold" Color="#FFD700" Opacity="0.8"/>

    <!-- Transparent & Semitransparent Brushes -->
    <SolidColorBrush x:Key="DarkOverlay" Color="#0A0E27" Opacity="0.9"/>
    <SolidColorBrush x:Key="MidOverlay" Color="#151A35" Opacity="0.7"/>
    <SolidColorBrush x:Key="LightOverlay" Color="#F5F5F5" Opacity="0.05"/>

</ResourceDictionary>
