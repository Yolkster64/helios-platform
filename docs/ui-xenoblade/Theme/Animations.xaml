<!--
    NON-CANONICAL PALETTE - reference only (do not consume from app XAML, and do not
    "fix" colors here). The single color authority for all HELIOS UI is
    src/gui/HELIOS.Shell/Themes/Tokens.xaml and its sibling theme packs
    (decision record: docs/architecture/GUI_UPGRADE_PLAN.md section 2). Mine this file
    for ramps and treatments; route any token change through Tokens.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pulse Animation (1.5Hz frequency = 666ms per cycle) -->
    <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="1" To="0.6" 
            Duration="0:0:0.666"
            EasingFunction="{StaticResource SmoothEaseInOut}"/>
    </Storyboard>

    <!-- Glow Pulse Animation -->
    <Storyboard x:Key="GlowPulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0.8" To="0.3" 
            Duration="0:0:0.666"
            EasingFunction="{StaticResource SmoothEaseInOut}"/>
    </Storyboard>

    <!-- Scale Pulse Animation -->
    <Storyboard x:Key="ScalePulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            From="1.0" To="1.05" 
            Duration="0:0:0.666"
            EasingFunction="{StaticResource SmoothEaseInOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            From="1.0" To="1.05" 
            Duration="0:0:0.666"
            EasingFunction="{StaticResource SmoothEaseInOut}"/>
    </Storyboard>

    <!-- Slide In Animation (from top) -->
    <Storyboard x:Key="SlideInFromTopAnimation">
        <ThicknessAnimation 
            Storyboard.TargetProperty="Margin"
            From="0,-50,0,0" To="0,0,0,0"
            Duration="0:0:0.5"
            EasingFunction="{StaticResource SmoothEaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="0:0:0.5"
            EasingFunction="{StaticResource SmoothEaseOut}"/>
    </Storyboard>

    <!-- Slide In Animation (from right) -->
    <Storyboard x:Key="SlideInFromRightAnimation">
        <ThicknessAnimation 
            Storyboard.TargetProperty="Margin"
            From="200,0,0,0" To="0,0,0,0"
            Duration="0:0:0.5"
            EasingFunction="{StaticResource SmoothEaseOut}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="0:0:0.5"
            EasingFunction="{StaticResource SmoothEaseOut}"/>
    </Storyboard>

    <!-- Fade In Animation -->
    <Storyboard x:Key="FadeInAnimation">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0" To="1"
            Duration="0:0:0.3"
            EasingFunction="{StaticResource SmoothEaseOut}"/>
    </Storyboard>

    <!-- Fade Out Animation -->
    <Storyboard x:Key="FadeOutAnimation">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="1" To="0"
            Duration="0:0:0.3"
            EasingFunction="{StaticResource SmoothEaseIn}"/>
    </Storyboard>

    <!-- Color Transition Animation -->
    <Storyboard x:Key="ColorTransitionAnimation">
        <ColorAnimation 
            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
            From="#00D4FF" To="#0080FF"
            Duration="0:0:0.5"
            EasingFunction="{StaticResource SmoothEaseInOut}"
            AutoReverse="True"
            RepeatBehavior="Forever"/>
    </Storyboard>

    <!-- Easing Functions -->
    <CubicEase x:Key="SmoothEaseIn" EasingMode="EaseIn"/>
    <CubicEase x:Key="SmoothEaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="SmoothEaseInOut" EasingMode="EaseInOut"/>

    <!-- Spin Animation (for loading indicators) -->
    <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
            From="0" To="360"
            Duration="0:0:2"
            EasingFunction="{StaticResource LinearEase}"/>
    </Storyboard>

    <LinearEase x:Key="LinearEase"/>

    <!-- Button Hover Glow Animation -->
    <Storyboard x:Key="ButtonHoverGlowAnimation">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="0.3" To="0.8"
            Duration="0:0:0.3"
            EasingFunction="{StaticResource SmoothEaseOut}"/>
    </Storyboard>

    <!-- Energy Discharge Animation -->
    <Storyboard x:Key="EnergyDischargeAnimation" Duration="0:0:0.8">
        <DoubleAnimation 
            Storyboard.TargetProperty="Opacity"
            From="1" To="0"
            Duration="0:0:0.8"
            EasingFunction="{StaticResource SmoothEaseIn}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            From="1" To="2"
            Duration="0:0:0.8"
            EasingFunction="{StaticResource SmoothEaseIn}"/>
        <DoubleAnimation 
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            From="1" To="2"
            Duration="0:0:0.8"
            EasingFunction="{StaticResource SmoothEaseIn}"/>
    </Storyboard>

</ResourceDictionary>
