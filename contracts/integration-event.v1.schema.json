{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helios.dev/contracts/integration-event.v1.schema.json",
  "title": "HELIOS Integration Event v1",
  "description": "Transport-neutral envelope for HELIOS commands, results, approvals, deployments, connector deliveries, and fleet jobs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "source",
    "repository",
    "sourceSha",
    "correlationId",
    "idempotencyKey",
    "environment",
    "occurredAt",
    "dataClassification",
    "actor",
    "links",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "description": "A registered ID from integration-event-types.v1.json."
    },
    "source": {
      "type": "string",
      "enum": [
        "github",
        "azure",
        "azure-devops",
        "service-bus",
        "event-grid",
        "helios-platform",
        "hermes",
        "xcore",
        "codex",
        "github-copilot",
        "microsoft-copilot",
        "copilot-studio",
        "chatgpt",
        "openai-api",
        "claude",
        "slack",
        "linear",
        "sharepoint",
        "monado-blade"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "description": "Immutable Git commit SHA for the code that emitted the event."
    },
    "entityId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{3,127}$"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataClassification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "service",
            "agent",
            "workflow"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceparent"
      ],
      "properties": {
        "traceparent": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "tracestate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": [
          "rel"
        ],
        "properties": {
          "rel": {
            "const": "receipt"
          }
        }
      },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel",
          "href"
        ],
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "source",
              "subject",
              "receipt",
              "approval",
              "evidence",
              "result",
              "parent"
            ]
          },
          "href": {
            "type": "string",
            "format": "uri",
            "pattern": "^(https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?#][^\\s]*)?|urn:[A-Za-z0-9][A-Za-z0-9-]{0,30}[A-Za-z0-9]:[^/?#][^?#]*)$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
