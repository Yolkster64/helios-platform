<Page
    x:Class="HELIOS.Shell.Views.AIHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HELIOS.Shell.Helpers"
    xmlns:vm="using:HELIOS.Shell.ViewModels"
    Background="{ThemeResource SurfaceBrush}">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + refresh + resolved API URL -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="AI Hub"
                           Style="{StaticResource HeliosHeadlineTextBlockStyle}"
                           Foreground="{ThemeResource HeliosAccentBrush}" />
                <TextBlock Foreground="{ThemeResource TextSecondaryBrush}">
                    <Run Text="Provider status from helios-ai-api at" />
                    <Run Text="{x:Bind ViewModel.ApiBaseUrl}" />
                </TextBlock>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing Grid.Column="1" Width="24" Height="24"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <Button Grid.Column="2" Content="Refresh" VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <!-- Graceful "API not running" state -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsApiUnavailable, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Warning"
                 Title="API not running"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- Provider list. Rows are immutable records rebuilt on refresh, so the
             default x:Bind OneTime mode inside the template is correct. -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Providers}"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderItemViewModel">
                    <Border Background="{ThemeResource CardSurfaceBrush}"
                            BorderBrush="{ThemeResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind helpers:ReadinessVisuals.BrushFor(Readiness)}" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource HeliosBodyStrongTextBlockStyle}">
                                    <Run Text="{x:Bind Name}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind Kind}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind ModelDisplay}"
                                           Style="{StaticResource HeliosBodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind DetailDisplay}"
                                           Visibility="{x:Bind HasDetail}"
                                           Style="{StaticResource HeliosCaptionTextBlockStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind Readiness}"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind helpers:ReadinessVisuals.BrushFor(Readiness)}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
