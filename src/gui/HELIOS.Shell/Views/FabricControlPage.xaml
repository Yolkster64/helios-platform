<Page
    x:Class="HELIOS.Shell.Views.FabricControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HELIOS.Shell.Helpers"
    xmlns:vm="using:HELIOS.Shell.ViewModels"
    Background="{ThemeResource SurfaceBrush}">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Fabric Control"
                           Style="{StaticResource HeliosHeadlineTextBlockStyle}"
                           Foreground="{ThemeResource HeliosAccentBrush}" />
                <TextBlock Text="GitHub · Claude Code · Azure OIDC · Foundry · Key Vault · OpenAI/Codex · Hermes · collaboration connectors"
                           Style="{StaticResource HeliosBodyTextBlockStyle}"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource HeliosCaptionTextBlockStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource CardSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="10">
                <TextBlock Text="Operator actions"
                           Style="{StaticResource HeliosTitleTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy bootstrap"
                            Command="{x:Bind ViewModel.CopyBootstrapCommand}" />
                    <Button Content="Copy verify-only"
                            Command="{x:Bind ViewModel.CopyVerifyCommand}" />
                    <Button Content="Azure portal"
                            Command="{x:Bind ViewModel.OpenAzurePortalCommand}" />
                    <Button Content="Claude workflow"
                            Command="{x:Bind ViewModel.OpenClaudeWorkflowCommand}" />
                    <Button Content="GitHub repo"
                            Command="{x:Bind ViewModel.OpenRepositoryCommand}" />
                </StackPanel>

                <TextBlock Text="Bootstrap"
                           Style="{StaticResource HeliosLabelTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.BootstrapCommand}"
                           Style="{StaticResource HeliosMonospaceTextBlockStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Verify without mutation"
                           Style="{StaticResource HeliosLabelTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.VerifyCommand}"
                           Style="{StaticResource HeliosMonospaceTextBlockStyle}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="OIDC issue #146"
                            Command="{x:Bind ViewModel.OpenClaudeIssueCommand}" />
                    <Button Content="Fix PR #152"
                            Command="{x:Bind ViewModel.OpenClaudePrCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar Grid.Row="2"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Informational"
                 Title="Credential boundary"
                 Message="This panel displays readiness only. It never renders secret values, grants Azure roles, accepts Marketplace terms, deploys models, or performs cloud writes." />

        <ListView Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Integrations}"
                  SelectionMode="None"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FabricIntegrationItemViewModel">
                    <Border Background="{ThemeResource CardSurfaceBrush}"
                            BorderBrush="{ThemeResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0"
                                     Width="10"
                                     Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind helpers:ReadinessVisuals.BrushFor(Readiness)}" />

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource HeliosBodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Scope}"
                                           Style="{StaticResource HeliosCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Detail}"
                                           Style="{StaticResource HeliosBodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Readiness}"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind helpers:ReadinessVisuals.BrushFor(Readiness)}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
