<Page x:Class="HELIOS.Shell.Views.UsbSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:HELIOS.Shell.ViewModels"
      Background="{ThemeResource SurfaceBrush}">
    <Page.Resources>
        <DataTemplate x:Key="PlanRowTemplate" x:DataType="vm:UsbPlanRow">
            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource HeliosBodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource HeliosBodyTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="USB setup" Style="{StaticResource HeliosHeadlineTextBlockStyle}" Foreground="{ThemeResource HeliosAccentBrush}" />
            <TextBlock Text="Choose a profile → describe the USB → preview the plan" Style="{StaticResource HeliosTitleTextBlockStyle}" TextWrapping="Wrap" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Plan only"
                     Message="This page uses the device details you enter. It cannot scan, format or write a disk, install Windows or change boot settings." />
            <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <ComboBox Header="1  Profile" ItemsSource="{x:Bind ViewModel.Profiles}" SelectedIndex="{x:Bind ViewModel.ProfileIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Recovery, vault and quarantine are storage functions within a profile." Style="{StaticResource HeliosBodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBox Header="2  Physical USB device ID or serial (entered manually)" MaxLength="128" Text="{x:Bind ViewModel.DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="USB capacity in MiB (1 GiB = 1024 MiB)" MaxLength="12" Text="{x:Bind ViewModel.CapacityMiB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Complete extracted installation media size in MiB" MaxLength="8" Text="{x:Bind ViewModel.MediaSizeMiB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Largest extracted file size in MiB (round up)" MaxLength="8" Text="{x:Bind ViewModel.LargestFileMiB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Confirm from your device inventory. Leaving a box unchecked means unknown." Style="{StaticResource HeliosBodyTextBlockStyle}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{x:Bind ViewModel.IsRemovable, Mode=TwoWay}"><TextBlock Text="The target is removable USB media" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{x:Bind ViewModel.IsNotSystemDisk, Mode=TwoWay}"><TextBlock Text="The target does not contain the current system" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{x:Bind ViewModel.IsNotBootDisk, Mode=TwoWay}"><TextBlock Text="The target is not the current boot disk" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{x:Bind ViewModel.IsWritable, Mode=TwoWay}"><TextBlock Text="The target is not read-only" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{x:Bind ViewModel.UefiConfirmed, Mode=TwoWay}"><TextBlock Text="The destination computer supports UEFI" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{x:Bind ViewModel.BackupConfirmed, Mode=TwoWay}"><TextBlock Text="I have verified a backup of the target data" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox IsChecked="{x:Bind ViewModel.ImageVerified, Mode=TwoWay}"><TextBlock Text="I have checked the official installation media source and integrity" TextWrapping="Wrap" /></CheckBox>
                    <Button Content="3  Preview USB plan" Command="{x:Bind ViewModel.PreviewCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{x:Bind ViewModel.PlanState, Mode=OneWay}" Style="{StaticResource HeliosBodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsTextSelectionEnabled="True" />
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay}">
                <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="USB media proposal" Style="{StaticResource HeliosTitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Layout}" ItemTemplate="{StaticResource PlanRowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Missing details and next checks" Style="{StaticResource HeliosTitleTextBlockStyle}" TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Diagnostics}" ItemTemplate="{StaticResource PlanRowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Installed computer requirements" Style="{StaticResource HeliosTitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="These are later setup requirements for the destination computer. They are not partitions on this USB." Style="{StaticResource HeliosBodyTextBlockStyle}" TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Requirements}" ItemTemplate="{StaticResource PlanRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
