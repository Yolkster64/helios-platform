<UserControl x:Class="HELIOS.Shell.Controls.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ReadinessStates">
                <VisualState x:Name="Unconfigured">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource ProviderUnconfiguredBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource ProviderUnconfiguredBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Ready">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource ProviderReadyBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource ProviderReadyBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Degraded">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource ProviderDegradedBrush}" />
                        <Setter Target="StateText.Foreground" Value="{ThemeResource ProviderDegradedBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{ThemeResource ProviderUnconfiguredBrush}" />
                <TextBlock x:Name="StateText" Text="{x:Bind State, Mode=OneWay}" Foreground="{ThemeResource ProviderUnconfiguredBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource HeliosBodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource HeliosBodyTextBlockStyle}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource HeliosCaptionTextBlockStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
