<Application
    x:Class="HELIOS.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI control styles (Fluent). Must be first so app dictionaries can override. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Canonical semantic tokens (GUI_UPGRADE_PLAN.md section 2): the Monado
                     pack, default of the theme packs under Themes/. All pages reference
                     tokens via {ThemeResource}; no XAML outside the Themes/Tokens*.xaml
                     pack files names a literal color. -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <!-- Type ramp (P1): Display/Headline/Title/Body/Label TextBlock styles
                     consuming only semantic tokens. -->
                <ResourceDictionary Source="ms-appx:///Themes/Typography.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
