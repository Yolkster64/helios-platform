<Window
    x:Class="HELIOS.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Home follows the shared project flow; specialized views stay one click away. -->
    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Auto"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        SelectionChanged="OnNavSelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="home">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AIHubNavItem" Content="AI Hub" Tag="aihub">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE99A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="FabricNavItem" Content="Fabric" Tag="fabric">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="UsbNavItem" Content="USB setup" Tag="usb">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE88E;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="WorkbenchNavItem" Content="Workbench" Tag="workbench">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Routing" Tag="routing" IsEnabled="False"
                                ToolTipService.ToolTip="Task-routing grid — roadmap PR6">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8AB;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Fleet" Tag="fleet" IsEnabled="False"
                                ToolTipService.ToolTip="Xcore-9s pool state — roadmap PR6">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" Background="{ThemeResource SurfaceBrush}" Navigated="OnContentFrameNavigated" />
    </NavigationView>
</Window>
