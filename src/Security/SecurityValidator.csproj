<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Legacy project quarantined from central package management
         (Directory.Packages.props): its pinned PackageReference versions must
         keep restoring exactly as before until the project builds again -
         without this opt-out, repo-root CPM fails the restore with NU1008. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
