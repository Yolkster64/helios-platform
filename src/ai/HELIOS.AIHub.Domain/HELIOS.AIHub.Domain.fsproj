<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>HELIOS.AIHub.Domain</RootNamespace>
    <Description>F# domain model for AIHub cost and routing decisions. Pure functions only — the C# orchestrator owns all I/O.</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pricing.fs" />
    <Compile Include="ContextBudget.fs" />
    <Compile Include="ModelSelection.fs" />
    <Compile Include="RoutingPolicy.fs" />
    <Compile Include="LearnerFusion.fs" />
  </ItemGroup>

</Project>
