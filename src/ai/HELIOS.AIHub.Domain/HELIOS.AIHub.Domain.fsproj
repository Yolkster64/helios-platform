<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>HELIOS.AIHub.Domain</RootNamespace>
    <Description>F# domain model for AIHub cost and routing decisions. Pure functions only — the C# orchestrator owns all I/O.</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The explicit FSharp.Core reference below replaces the SDK's
         implicit injection entirely; without this switch the two coexist
         in non-CPM restore contexts and NU1504 duplicate warnings fire. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit (versionless - central package management supplies 8.0.403):
         the SDK's implicit FSharp.Core does not flow transitively under CPM,
         which strips FSharp.Core.dll from consuming C# project outputs. -->
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Pricing.fs" />
    <Compile Include="ContextBudget.fs" />
    <Compile Include="ModelSelection.fs" />
    <Compile Include="RoutingPolicy.fs" />
    <Compile Include="LearnerFusion.fs" />
  </ItemGroup>

</Project>
