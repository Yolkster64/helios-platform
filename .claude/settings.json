{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push * main*)",
      "Bash(az role assignment create*)",
      "Bash(az ad app credential*)",
      "Bash(az group delete*)",
      "Bash(az resource delete*)"
    ]
  },
  "extraKnownMarketplaces": {
    "helios-platform": {
      "source": {
        "source": "github",
        "repo": "Yolkster64/helios-platform"
      }
    }
  },
  "enabledPlugins": {
    "helios-operator@helios-platform": true
  }
}
