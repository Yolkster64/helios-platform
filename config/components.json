{
  "$schema": "./schemas/components.schema.json",
  "schemaVersion": 1,
  "repository": "Yolkster64/helios-platform",
  "sourcePolicy": "single-repository",
  "parts": {
    "core": {
      "name": "Core",
      "purpose": "AIHub, model routing, shared MCP/API, learning and the Python spoke.",
      "paths": [
        "src/ai",
        "src/mcp",
        "tests/HELIOS.AIHub.Tests",
        "config/aihub.json"
      ],
      "testProfile": "core",
      "workflows": [
        ".github/workflows/dotnet-build.yml",
        ".github/workflows/remote-mcp.yml",
        ".github/workflows/python-spoke.yml"
      ],
      "artifacts": [
        "src/ai/HELIOS.AIHub/HELIOS.AIHub.csproj",
        "src/mcp/HELIOS.RemoteMcp/HELIOS.RemoteMcp.csproj"
      ],
      "dependsOn": [],
      "releaseBoundary": "Build/publish projects locally; remote hosting uses the Cloud plan."
    },
    "desktop": {
      "name": "Desktop",
      "purpose": "Native application host, navigation, window lifecycle and package/build definition.",
      "paths": [
        "src/gui/HELIOS.Shell/App.xaml",
        "src/gui/HELIOS.Shell/App.xaml.cs",
        "src/gui/HELIOS.Shell/MainWindow.xaml",
        "src/gui/HELIOS.Shell/MainWindow.xaml.cs",
        "src/gui/HELIOS.Shell/HELIOS.Shell.csproj"
      ],
      "testProfile": "desktop",
      "workflows": [
        ".github/workflows/gui-windows.yml"
      ],
      "artifacts": [
        "src/gui/HELIOS.Shell.sln",
        "src/gui/HELIOS.Shell/HELIOS.Shell.csproj"
      ],
      "dependsOn": [
        "core",
        "gui"
      ],
      "releaseBoundary": "Windows build and packaging boundary; no installer publishing from this helper."
    },
    "gui": {
      "name": "GUI",
      "purpose": "Editable native views and reusable visual pieces, hosted by Desktop.",
      "paths": [
        "src/gui/HELIOS.Shell/Views",
        "src/gui/HELIOS.Shell/ViewModels",
        "src/gui/HELIOS.Shell/Themes",
        "config/ui",
        "src/gui/HELIOS.Shell/Controls",
        "src/gui/HELIOS.Shell/Services/GuiWorkbenchCatalog.cs"
      ],
      "testProfile": "gui",
      "workflows": [
        ".github/workflows/gui-windows.yml",
        ".github/workflows/component-contracts.yml"
      ],
      "artifacts": [
        "src/gui/HELIOS.Shell/HELIOS.Shell.csproj"
      ],
      "dependsOn": [
        "core"
      ],
      "releaseBoundary": "One shared native build validates every view. Piece selection limits edit scope only; Desktop owns the host/package and Cloud owns remote deployment.",
      "pieces": {
        "home": {
          "name": "Home",
          "purpose": "Project overview, connection status and starting actions.",
          "paths": [
            "src/gui/HELIOS.Shell/Views/ControlHomePage.xaml",
            "src/gui/HELIOS.Shell/Views/ControlHomePage.xaml.cs",
            "src/gui/HELIOS.Shell/ViewModels/ControlHomePageViewModel.cs"
          ],
          "linkedParts": [
            "core",
            "cloud"
          ]
        },
        "aihub": {
          "name": "AIHub",
          "purpose": "Provider status and shared status-card presentation; backed by the AIHub API.",
          "paths": [
            "src/gui/HELIOS.Shell/Views/AIHubPage.xaml",
            "src/gui/HELIOS.Shell/Views/AIHubPage.xaml.cs",
            "src/gui/HELIOS.Shell/ViewModels/AIHubPageViewModel.cs",
            "src/gui/HELIOS.Shell/Services/AIHubApiClient.cs",
            "src/gui/HELIOS.Shell/Controls/StatusCard.xaml",
            "src/gui/HELIOS.Shell/Controls/StatusCard.xaml.cs"
          ],
          "linkedParts": [
            "core",
            "fleet"
          ]
        },
        "fabric": {
          "name": "Fabric",
          "purpose": "Unified connector and cloud/fleet integration status.",
          "paths": [
            "src/gui/HELIOS.Shell/Views/FabricControlPage.xaml",
            "src/gui/HELIOS.Shell/Views/FabricControlPage.xaml.cs",
            "src/gui/HELIOS.Shell/ViewModels/FabricControlPageViewModel.cs"
          ],
          "linkedParts": [
            "core",
            "cloud",
            "fleet"
          ]
        },
        "usb": {
          "name": "USB",
          "purpose": "Non-destructive USB plan editing, capacity checks and preview.",
          "paths": [
            "src/gui/HELIOS.Shell/Views/UsbSetupPage.xaml",
            "src/gui/HELIOS.Shell/Views/UsbSetupPage.xaml.cs",
            "src/gui/HELIOS.Shell/ViewModels/UsbSetupPageViewModel.cs"
          ],
          "linkedParts": [
            "usb",
            "core"
          ]
        },
        "themes": {
          "name": "Theme",
          "purpose": "Shared colors, typography and visual tokens across native views.",
          "paths": [
            "src/gui/HELIOS.Shell/Themes",
            "config/ui"
          ],
          "linkedParts": [
            "desktop"
          ]
        }
      }
    },
    "usb": {
      "name": "USB",
      "purpose": "Portable, non-destructive USB setup planning and the native wizard.",
      "paths": [
        "src/ai/HELIOS.AIHub/Setup",
        "tests/HELIOS.AIHub.Tests/Setup",
        "src/gui/HELIOS.Shell/Views/UsbSetupPage.xaml"
      ],
      "testProfile": "usb",
      "workflows": [
        ".github/workflows/component-contracts.yml",
        ".github/workflows/gui-windows.yml"
      ],
      "artifacts": [
        "src/ai/HELIOS.AIHub/Setup/UsbSetupPlanner.cs"
      ],
      "dependsOn": [
        "core",
        "gui"
      ],
      "releaseBoundary": "Plan data only. No formatting, disk access, ISO writing, boot edits or legacy repair script execution."
    },
    "cloud": {
      "name": "Cloud",
      "purpose": "Azure identity, Key Vault, Foundry, storage and protected deployment templates.",
      "paths": [
        "infra",
        "scripts/bootstrap/identity_plan.py",
        "scripts/bootstrap/azure-oidc-setup.sh",
        "scripts/bootstrap/azure-oidc-setup.ps1"
      ],
      "testProfile": "cloud",
      "workflows": [
        ".github/workflows/infra-validate.yml",
        ".github/workflows/azure-oidc-contracts.yml",
        ".github/workflows/helios-deploy.yml"
      ],
      "artifacts": [
        "infra/main.bicep",
        "infra/main.bicepparam",
        "infra/arm/main.json"
      ],
      "dependsOn": [
        "core"
      ],
      "releaseBoundary": "Bicep owns Azure resources. Only main through protected azure-dev may run the deployment workflow; this helper never dispatches it."
    },
    "fleet": {
      "name": "Fleet",
      "purpose": "Hermes/XCore topology, readiness, worker contracts and evidence.",
      "paths": [
        "src/ai/HELIOS.AIHub/Fleet",
        "scripts/fleet",
        "config/fleet/fleet-topology.json",
        "src/ai/python/helios_agents"
      ],
      "testProfile": "fleet",
      "workflows": [
        ".github/workflows/dotnet-build.yml",
        ".github/workflows/python-spoke.yml",
        ".github/workflows/fleet-learning.yml"
      ],
      "artifacts": [
        "config/fleet/fleet-topology.json",
        "infra/modules/fleet-vmss.bicep"
      ],
      "dependsOn": [
        "core",
        "cloud"
      ],
      "releaseBoundary": "Tests exercise contracts and simulations. Worker activation and optional cloud burst remain separate reviewed operations."
    }
  }
}
