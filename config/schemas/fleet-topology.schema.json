{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helios://config/schemas/fleet-topology.schema.json",
  "title": "HELIOS agent-fleet topology v2 (config/fleet/fleet-topology.json)",
  "description": "Declarative pool layout (docs/architecture/HERMES_FLEET_AND_XCORE.md). Bound read-only by src/ai/HELIOS.AIHub/Fleet/FleetTopology.cs (version, pools[].name / taskTypes / providerChain / hermesFleet); scripts/fleet/start-fleet.ps1 reads defaults.spawn and each pool's hermesFleet / assigneePrefix / taskTypes, scripts/fleet/scale-fleet.ps1 merges each pool's autoscaling over defaults.autoscaling. version is pinned to 2: a v3 layout gets a v3 schema, not a silently half-read file. Objects are closed so a misspelled key (maxLocalLane, providerchain) fails here instead of falling back to a default at run time; every object accepts a $comment.",
  "type": "object",
  "required": ["version", "defaults", "pools"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "$comment": { "type": "string" },
    "version": { "type": "integer", "const": 2 },
    "defaults": { "$ref": "#/$defs/defaults" },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pool" }
    },
    "coordination": { "$ref": "#/$defs/coordination" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "taskType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "A config/aihub.json taskRouting key."
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "nameList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "lanes": { "type": "integer", "minimum": 0 },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "argsTemplate": {
          "type": "string",
          "pattern": "\\{prompt\\}",
          "description": "Must carry the {prompt} slot; {assignee} is substituted when present. Passed as argv, never through a shell."
        },
        "envContract": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/envName" }
        },
        "termination": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["kanban_complete", "kanban_block"] }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["hybrid", "local", "cloud"],
          "description": "hybrid = warm local lanes plus ARC burst; local = never burst; cloud = never run locally."
        },
        "minLocalLanes": { "$ref": "#/$defs/lanes" },
        "maxLocalLanes": { "$ref": "#/$defs/lanes" },
        "burstTarget": { "type": "string", "minLength": 1 },
        "maxBurstLanes": { "$ref": "#/$defs/lanes" },
        "scaleUpQueueDepth": { "$ref": "#/$defs/lanes" },
        "scaleDownIdleSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "hermesFleet": {
      "type": "object",
      "required": ["board", "maxConcurrentLanes"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "board": { "$ref": "#/$defs/identifier" },
        "maxConcurrentLanes": { "type": "integer", "minimum": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "poolSize": { "type": "integer", "minimum": 1 },
        "spawn": { "$ref": "#/$defs/spawn" },
        "autoscaling": { "$ref": "#/$defs/autoscaling" },
        "hermesFleet": { "$ref": "#/$defs/hermesFleet" }
      }
    },
    "pool": {
      "type": "object",
      "required": ["name", "hermesFleet", "taskTypes", "providerChain"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "name": { "$ref": "#/$defs/identifier" },
        "specialization": { "type": "string" },
        "assigneePrefix": { "$ref": "#/$defs/identifier" },
        "poolSize": { "type": "integer", "minimum": 1 },
        "hermesFleet": { "$ref": "#/$defs/hermesFleet" },
        "taskTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/taskType" }
        },
        "providerChain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Ordered provider / CLI-agent names from config/aihub.json; first is primary."
        },
        "tools": { "$ref": "#/$defs/nameList" },
        "skills": { "$ref": "#/$defs/nameList" },
        "agents": { "$ref": "#/$defs/nameList" },
        "autoscaling": { "$ref": "#/$defs/autoscaling" }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["from", "to", "when"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "when": { "type": "string", "minLength": 1 }
      }
    },
    "coordination": {
      "type": "object",
      "required": ["handoffs"],
      "additionalProperties": false,
      "properties": {
        "$comment": { "type": "string" },
        "handoffs": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoff" }
        },
        "aihubTaskType": { "$ref": "#/$defs/taskType" }
      }
    }
  }
}
