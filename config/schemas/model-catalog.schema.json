{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helios://config/schemas/model-catalog.schema.json",
  "title": "HELIOS model catalog (config/model-catalog.json)",
  "description": "Published capability/cost/speed profiles per provider/model. Field names must match the C# binder (src/ai/HELIOS.AIHub/Configuration/ModelCatalog.cs). Enforced in CI by scripts/build/validate-model-catalog.py (stdlib-only; reads the enums below, so extend provider/class/speed lists HERE).",
  "type": "object",
  "required": ["models"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/modelProfile" }
    },
    "selectionPolicy": {
      "type": "object",
      "description": "Free-form documentation of the cost/latency/quality selection rules; not machine-bound."
    }
  },
  "$defs": {
    "modelProfile": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "class",
        "contextTokens",
        "inputPerMillionUsd",
        "outputPerMillionUsd",
        "relativeSpeed",
        "strengths"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Must be a provider key known to config/aihub.json.",
          "enum": ["anthropic", "openai", "azure-openai", "azure-foundry", "github-models", "ollama"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Provider-native model id (never empty)."
        },
        "class": {
          "type": "string",
          "enum": ["frontier", "balanced", "specialist", "fast", "local"]
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "inputPerMillionUsd": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillionUsd": {
          "type": "number",
          "minimum": 0
        },
        "relativeSpeed": {
          "type": "string",
          "enum": ["fast", "medium", "slow", "hardware-bound"]
        },
        "strengths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Task types (config/aihub.json taskRouting keys) this model is a strong pick for."
        },
        "note": { "type": "string" }
      }
    }
  }
}
