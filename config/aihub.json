{
  "$comment": "HELIOS multi-LLM hub configuration. No secrets live here \u2014 only the names of environment variables (Key Vault secret names as fallback). Task routing chains are ordered: first entry is primary, the rest are fallbacks.",
  "providers": {
    "openai": {
      "type": "openai",
      "model": "gpt-5-mini",
      "apiKeyEnv": "OPENAI_API_KEY",
      "apiKeySecretName": "openai-api-key"
    },
    "openai-codex": {
      "$comment": "Alias onto the same OpenAI platform/key as 'openai' - the codegen-specialist lane for CI/containers where the codex CLI is absent. gpt-5.1-codex-max is the catalog's codegen specialist (config/model-catalog.json); it has not been live-smoked from this keyless environment - if a keyed run shows the model rejecting chat completions, swap to gpt-5.4 (FallbackChain advances past a failing provider either way).",
      "type": "openai",
      "model": "gpt-5.1-codex-max",
      "apiKeyEnv": "OPENAI_API_KEY",
      "apiKeySecretName": "openai-api-key"
    },
    "anthropic": {
      "type": "anthropic",
      "model": "claude-sonnet-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "apiKeySecretName": "anthropic-api-key"
    },
    "anthropic-foundry": {
      "$comment": "Claude deployed in Microsoft Foundry, reached through the Anthropic Messages API at https://<resource>.services.ai.azure.com/anthropic. 'model' is the Foundry DEPLOYMENT name (may differ from the model id) - the same deployments scripts/ai-integration/Connect-ClaudeFoundry.ps1 targets. endpointEnv holds either a bare Foundry resource name or an absolute https base URL. When the key env var / Key Vault secret is absent the provider falls back to Microsoft Entra ID (DefaultAzureCredential, scope https://ai.azure.com/.default) exactly like azure-openai; it is Unconfigured only when the resource is unset.",
      "type": "anthropic-foundry",
      "model": "claude-sonnet-4-6",
      "endpointEnv": "ANTHROPIC_FOUNDRY_RESOURCE",
      "apiKeyEnv": "ANTHROPIC_FOUNDRY_API_KEY",
      "apiKeySecretName": "anthropic-foundry-api-key"
    },
    "azure-openai": {
      "type": "azure-openai",
      "model": "gpt-5-mini",
      "endpointEnv": "AZURE_OPENAI_ENDPOINT",
      "apiKeyEnv": "AZURE_OPENAI_API_KEY"
    },
    "github-models": {
      "type": "github-models",
      "model": "openai/gpt-5-mini",
      "apiKeyEnv": "GITHUB_MODELS_TOKEN",
      "apiKeySecretName": "github-models-token"
    },
    "ollama": {
      "type": "ollama",
      "model": "llama3.2",
      "endpointEnv": "OLLAMA_BASE_URL"
    },
    "azure-foundry": {
      "type": "azure-foundry-agent",
      "model": "gpt-5-mini",
      "endpointEnv": "AZURE_FOUNDRY_PROJECT_ENDPOINT"
    }
  },
  "cliAgents": [
    {
      "name": "claude-cli",
      "command": "claude",
      "argsTemplate": "-p {prompt}",
      "timeoutSeconds": 600
    },
    {
      "name": "codex",
      "command": "codex",
      "argsTemplate": "exec {prompt}",
      "timeoutSeconds": 600
    },
    {
      "name": "copilot",
      "command": "copilot",
      "argsTemplate": "-p {prompt}",
      "timeoutSeconds": 600
    },
    {
      "name": "gh-models",
      "command": "gh",
      "argsTemplate": "models run {model} {prompt}",
      "model": "openai/gpt-5-mini",
      "timeoutSeconds": 300
    },
    {
      "name": "hermes",
      "command": "hermes",
      "argsTemplate": "chat -q {prompt}",
      "timeoutSeconds": 600
    }
  ],
  "routing": {
    "defaultChain": [
      "azure-openai",
      "openai",
      "anthropic",
      "anthropic-foundry",
      "github-models",
      "ollama"
    ],
    "taskRouting": {
      "code_generation": [
        "codex",
        "openai-codex",
        "openai",
        "azure-openai",
        "anthropic"
      ],
      "code_refactoring": [
        "codex",
        "openai-codex",
        "anthropic",
        "openai"
      ],
      "test_creation": [
        "codex",
        "openai-codex",
        "openai",
        "anthropic"
      ],
      "code_review": [
        "anthropic",
        "anthropic-foundry",
        "claude-cli",
        "openai"
      ],
      "long_context_analysis": [
        "anthropic",
        "anthropic-foundry",
        "claude-cli"
      ],
      "documentation_generation": [
        "anthropic",
        "anthropic-foundry",
        "openai",
        "github-models"
      ],
      "code_analysis": [
        "anthropic",
        "anthropic-foundry",
        "openai"
      ],
      "debugging": [
        "claude-cli",
        "codex",
        "openai-codex",
        "openai"
      ],
      "security_analysis": [
        "anthropic",
        "anthropic-foundry",
        "openai"
      ],
      "architecture_design": [
        "anthropic",
        "anthropic-foundry",
        "openai"
      ],
      "enterprise_data": [
        "azure-foundry",
        "anthropic-foundry",
        "azure-openai"
      ],
      "inline_completion": [
        "copilot",
        "github-models"
      ],
      "agent_fleet_dispatch": [
        "hermes"
      ],
      "offline": [
        "ollama"
      ],
      "bulk_processing": [
        "github-models",
        "azure-openai",
        "ollama"
      ],
      "general_query": [
        "azure-openai",
        "openai",
        "github-models",
        "ollama"
      ]
    }
  },
  "learning": {
    "$comment": "Record-only by default: outcomes append to localPath (gitignored .helios/) and surface via /v1/learning, /v1/insights, and /v1/metrics, while routing chains stay exactly as configured. adaptiveRouting=true is the deliberate opt-in that lets recorded history reorder chains - off so routing never changes itself silently. Store failures degrade to a null store; the hub never blocks on learning.",
    "enabled": true,
    "mode": "local",
    "localPath": ".helios/learning/outcomes.jsonl",
    "tableEndpointEnv": "AZURE_LEARNING_TABLE_ENDPOINT",
    "adaptiveRouting": false,
    "historyWindow": 200
  }
}
