# API Keys for HELIOS AI Services
# This tracked file contains placeholders only. Copy it to `.env`, which is ignored,
# and put real credentials there. Never edit this template with secret values.

# ============================================================================
# Codex
# Get key at: https://platform.openai.com/account/api-keys
# ============================================================================
# Codex CLI can reuse `codex login`; the `openai-codex` API provider separately
# uses OPENAI_API_KEY (Key Vault: openai-api-key). CLI login does not issue a
# Platform model key. Keep each client's credential store outside this repo.
# (The 2023-era Codex API and code-davinci-002 no longer exist.)

# ============================================================================
# Learning store (optional): Azure Table endpoint for the shared outcome log.
# Read by config/aihub.json `learning.tableEndpointEnv`; unset = local JSONL only.
# ============================================================================
# export AZURE_LEARNING_TABLE_ENDPOINT="https://<storage-account>.table.core.windows.net"

# ============================================================================
# Legacy: read only by scripts/ai-services/ai-services-config.json (the 2023-era
# PowerShell hub the .NET hub replaced). The hub never reads these; keep them only
# if you still run those scripts.
# ============================================================================
export CHATGPT_API_KEY="sk-YOUR_CHATGPT_KEY_HERE"
export CHATGPT_MODEL="gpt-4"
export CHATGPT_ENABLED=true
export GPT45_API_KEY="sk-YOUR_GPT45_KEY_HERE"
export GPT45_MODEL="gpt-4-turbo-2024-04"
export GPT45_ENABLED=true
export COST_LIMIT_TOTAL=300
export COST_LIMIT_CHATGPT=100
export COST_LIMIT_GPT45=150

# ============================================================================
# Rate Limiting
# ============================================================================
export RATE_LIMIT_REQUESTS_PER_MINUTE=30
export RATE_LIMIT_REQUESTS_PER_DAY=500

# ============================================================================
# Hub Configuration
# ============================================================================
export AI_HUB_DEBUG=false
export AI_HUB_DRY_RUN=false
export AI_HUB_AUTO_APPROVE_THRESHOLD=0.95
export AI_HUB_CONFLICT_STRATEGY="consensus"

# ============================================================================
# HELIOS AIHub — multi-LLM providers (config/aihub.json reads these names)
# Resolution order per provider: env var → Azure Key Vault → Unconfigured.
# ============================================================================
export OPENAI_API_KEY=""               # value from Key Vault (openai-api-key) — source scripts/bootstrap/load-env-from-keyvault.sh
export ANTHROPIC_API_KEY=""            # value from Key Vault (anthropic-api-key) — source scripts/bootstrap/load-env-from-keyvault.sh

# From `az deployment group create … infra/main.bicep` outputs:
export AZURE_OPENAI_ENDPOINT="https://YOUR_ACCOUNT.openai.azure.com/"
export AZURE_OPENAI_API_KEY=""            # empty = Entra ID via DefaultAzureCredential
export AZURE_FOUNDRY_PROJECT_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT"
# Claude in Microsoft Foundry (anthropic-foundry provider; same resource/deployments as
# scripts/ai-integration/Connect-ClaudeFoundry.ps1). Resource NAME or https base URL:
export ANTHROPIC_FOUNDRY_RESOURCE=""      # e.g. "helios-aijcut" or "https://helios-aijcut.services.ai.azure.com/anthropic"
export ANTHROPIC_FOUNDRY_API_KEY=""       # empty = Entra ID via DefaultAzureCredential (Key Vault: anthropic-foundry-api-key)
export AZURE_KEY_VAULT_URI=""             # optional: Key Vault fallback for the keys above

# GitHub Models (PAT with models:read; falls back to GITHUB_TOKEN):
export GITHUB_MODELS_TOKEN=""

# Local inference:
export OLLAMA_BASE_URL="http://localhost:11434"

# REST API: loopback callers need no key when running directly. Docker bridge and
# remote callers send this value as X-HELIOS-Api-Key. Replace the local example.
export HELIOS_API_ACCESS_KEY="local-compose-only"
export HELIOS_API_URL="http://localhost:5170"

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this template to .env; do not place secrets in the tracked template.
# 2. Use bash connect.sh start --json (or connect.ps1 start --json on Windows).
#    The launcher does not source .env; load only the needed values into the
#    current process. Missing optional providers do not block the local core.
# 3. Prefer Azure managed identity for runtime access and GitHub OIDC for CI.
#    Model API keys, when required, are separate from CLI/ChatGPT sign-ins.
# 4. Use bash connect.sh identity --json for the offline identity/Key Vault plan.
#    Use connect.sh auth status for explicit bounded saved-session checks.
# 5. Read docs/CONNECT.md before inference or deployment. Neither startup nor
#    the identity plan invokes a model, creates credentials or applies Azure.

# Offline identity planner inputs (nonsecret IDs/names; examples intentionally
# absent so a placeholder cannot be mistaken for the operator's real target).
# AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID, AZURE_CLIENT_ID
# AZURE_RESOURCE_GROUP, AZURE_LOCATION, AZURE_KEY_VAULT_NAME
# Optional: HELIOS_RUNTIME_IDENTITY_NAME, HELIOS_RUNTIME_PRINCIPAL_ID,
# AZURE_LEARNING_STORAGE_ACCOUNT_NAME. The deployment client ID and runtime
# client ID belong to different principals; set AZURE_CLIENT_ID per process.
