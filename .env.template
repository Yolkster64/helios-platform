# API Keys for HELIOS AI Services
# This tracked file contains placeholders only. Copy it to `.env`, which is ignored,
# and put real credentials there. Never edit this template with secret values.

# ============================================================================
# ChatGPT Pro (GPT-4)
# Get key at: https://platform.openai.com/account/api-keys
# ============================================================================
export CHATGPT_API_KEY="sk-YOUR_CHATGPT_KEY_HERE"
export CHATGPT_MODEL="gpt-4"
export CHATGPT_ENABLED=true

# ============================================================================
# Codex
# Get key at: https://platform.openai.com/account/api-keys
# ============================================================================
export CODEX_API_KEY="sk-YOUR_CODEX_KEY_HERE"
export CODEX_MODEL="code-davinci-002"
export CODEX_TEMPERATURE=0.2
export CODEX_ENABLED=true

# ============================================================================
# GPT-4.5 (Latest Model)
# Get key at: https://platform.openai.com/account/api-keys
# ============================================================================
export GPT45_API_KEY="sk-YOUR_GPT45_KEY_HERE"
export GPT45_MODEL="gpt-4-turbo-2024-04"
export GPT45_ENABLED=true

# ============================================================================
# Cost Limits (USD per month)
# ============================================================================
export COST_LIMIT_TOTAL=300
export COST_LIMIT_CHATGPT=100
export COST_LIMIT_CODEX=50
export COST_LIMIT_GPT45=150

# ============================================================================
# Rate Limiting
# ============================================================================
export RATE_LIMIT_REQUESTS_PER_MINUTE=30
export RATE_LIMIT_REQUESTS_PER_DAY=500

# ============================================================================
# Hub Configuration
# ============================================================================
export AI_HUB_DEBUG=false
export AI_HUB_DRY_RUN=false
export AI_HUB_AUTO_APPROVE_THRESHOLD=0.95
export AI_HUB_CONFLICT_STRATEGY="consensus"

# ============================================================================
# HELIOS AIHub — multi-LLM providers (config/aihub.json reads these names)
# Resolution order per provider: env var → Azure Key Vault → Unconfigured.
# ============================================================================
export OPENAI_API_KEY="sk-YOUR_OPENAI_KEY_HERE"
export ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_KEY_HERE"

# From `az deployment group create … infra/main.bicep` outputs:
export AZURE_OPENAI_ENDPOINT="https://YOUR_ACCOUNT.openai.azure.com/"
export AZURE_OPENAI_API_KEY=""            # empty = Entra ID via DefaultAzureCredential
export AZURE_FOUNDRY_PROJECT_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT"
export AZURE_KEY_VAULT_URI=""             # optional: Key Vault fallback for the keys above

# GitHub Models (PAT with models:read; falls back to GITHUB_TOKEN):
export GITHUB_MODELS_TOKEN=""

# Local inference:
export OLLAMA_BASE_URL="http://localhost:11434"

# REST API: loopback callers need no key when running directly. Docker bridge and
# remote callers send this value as X-HELIOS-Api-Key. Replace the local example.
export HELIOS_API_ACCESS_KEY="local-compose-only"
export HELIOS_API_URL="http://localhost:5170"

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this template to .env; do not place secrets in the tracked template.
# 2. Get your API keys from https://platform.openai.com/account/api-keys
# 3. Replace placeholders in .env only, then source .env (Unix/Mac/WSL) or copy the
#    values to your PowerShell profile (Windows).
# 4. Verify: .\scripts\ai-services\validate-keys.ps1
# 5. Test: .\scripts\ai-services\test-services.ps1
